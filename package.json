{
  "name": "zentro",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "typecheck": "turbo run check-types",
    "validate": "pnpm lint && pnpm check-types && pnpm test",
    "dev:web": "turbo run dev --filter=@zentro/web",
    "prepare": "husky",
    "test": "turbo run test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@neon/config": "^1.14.1",
    "@neon/env": "^1.6.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20.19.26",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "turbo": "^2.11.11",
    "typescript": "5.9.2",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=18"
  }
}
