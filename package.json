{
  "name": "zentro",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "validate": "pnpm lint && pnpm check-types && pnpm build",
    "dev:web": "turbo run dev --filter=@zentro/web",
    "dev:authenticator": "turbo run dev --filter=@zentro/authenticator",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "@better-auth/drizzle-adapter": "^1.6.9",
      "@eslint/js": "^9.39.1",
      "@hookform/resolvers": "^5.2.2",
      "@next/eslint-plugin-next": "^16.2.0",
      "@tailwindcss/postcss": "^4.1.18",
      "@tanstack/react-query": "^5.100.11",
      "@tanstack/react-table": "^8.21.3",
      "@trpc/client": "^11.17.0",
      "@trpc/server": "^11.17.0",
      "@trpc/tanstack-react-query": "^11.17.0",
      "@types/node": "^20.19.26",
      "@types/pg": "^8.20.0",
      "@types/react": "19.2.4",
      "@types/react-dom": "^19.2.3",
      "better-auth": "^1.6.9",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "dotenv": "^17.4.2",
      "drizzle-kit": "^0.31.10",
      "drizzle-orm": "^0.45.2",
      "eslint": "^9.39.1",
      "eslint-config-prettier": "^10.1.1",
      "eslint-plugin-only-warn": "^1.1.0",
      "eslint-plugin-react": "^7.37.5",
      "eslint-plugin-react-hooks": "^5.2.0",
      "eslint-plugin-turbo": "^2.7.1",
      "globals": "^16.5.0",
      "husky": "^9.1.7",
      "input-otp": "^1.4.2",
      "lint-staged": "^16.2.7",
      "lucide-react": "^1.8.0",
      "next": "16.2.4",
      "next-themes": "^0.4.6",
      "pg": "^8.20.0",
      "prettier": "^3.7.4",
      "radix-ui": "^1.4.3",
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "react-hook-form": "^7.74.0",
      "resend": "^6.12.2",
      "shadcn": "^4.4.0",
      "sonner": "^2.0.7",
      "superjson": "^2.2.6",
      "tailwind-merge": "^3.5.0",
      "tailwindcss": "^4.1.18",
      "tsx": "^4.21.0",
      "turbo": "^2.9.6",
      "tw-animate-css": "^1.4.0",
      "typescript": "5.9.2",
      "typescript-eslint": "^8.50.0",
      "zod": "^4.3.6"
    }
  }
}
