# Single origin for the whole app (sign-in, dashboard, API).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Matches `docker compose up -d db` (override host port with POSTGRES_PORT)
DATABASE_URL=postgres://zentro:zentro@localhost:5432/zentro
POSTGRES_PASSWORD=zentro
POSTGRES_PORT=5432
RESEND_API_KEY=re_replace_with_resend_api_key
# Sender on a domain verified in Resend, e.g. Zentro <no-reply@yourdomain.com>.
# Without it, mail goes out from onboarding@resend.dev and only reaches the Resend account owner.
# EMAIL_FROM=
# Automated tests only; the name must end with _test. Start it with
# `docker compose --profile test up -d test-db`.
TEST_DATABASE_URL=postgres://zentro:zentro@localhost:5434/zentro_test
# Uploaded files (chat attachments). Defaults to a local ./.uploads folder.
# FILE_STORAGE=s3 with the settings below uses S3 or a compatible service.
# FILE_STORAGE=local
# FILE_STORAGE_DIR=
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
